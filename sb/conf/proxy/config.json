        "rule_set": ["geosite-microsoft@cn", "geosite-apple@cn", "geosite-cn"],
        "action": "evaluate",
        "server": "pubdns",
        "tag": "cn2"
      },
      {
        "match_response": "cn1",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "cn2",
        "action": "respond",
        "race": true
      },
      {
        "domain_suffix": ["home.com", "grady.com"],
        "server": "local"
      },
      {
        "clash_mode": "Direct",
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "server": "cfdns"
      },
      {
        "query_type": ["AAAA"],
        "action": "reject"
      },
      {
        "query_type": ["A"],
        "server": "fakeip"
      }
    ],
    "final": "ggdns",
    "strategy": "prefer_ipv4"
