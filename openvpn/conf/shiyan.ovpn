client
proto udp
remote 111.4.111.177 1194
dev tun
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name server_Uhhilq5toHh74Klr name
auth SHA256
auth-user-pass /etc/openvpn/auth
cipher AES-128-GCM
tls-client
tls-version-min 1.2
tls-cipher TLS-ECDHE-ECDSA-WITH-AES-128-GCM-SHA256
verb 3

explicit-exit-notify


## Custom configuration ##
route 172.30.0.0 255.255.0.0
route 192.168.100.0 255.255.255.0
route 10.0.100.0 255.255.255.0
## end ##

